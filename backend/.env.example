# Admin account (kept out of the repo; only you can see these values)
ADMIN_NAME=Admin
ADMIN_EMAIL=youremail@gmail.com
ADMIN_PASSWORD=change-this-password

# Email OTP (forgot password)
# Option A: Resend HTTP API (recommended for Render Free, which blocks SMTP ports)
RESEND_API_KEY=re_your_api_key
MAIL_FROM=NexMarket <onboarding@resend.dev>

# Option B: SMTP (not available on Render Free)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-app-password

# Optional MongoDB
# MONGODB_URI=mongodb+srv://user:pass@cluster/nexmarket

# Public site URL used for sitemap.xml and robots.txt (defaults to the request host)
# SITE_URL=https://nexmarket.online

# Extra allowed CORS origins, comma separated. nexmarket.online is allowed by default.
# CORS_ORIGINS=https://nexmarket.online,https://www.nexmarket.online
